                  "ElectionType": {
                    "type": "integer",
                    "format": "int32"
                  },
                  "ResidentialAddress": {
                    "type": "string"
                  },
                  "ProofFile": {
                    "type": "string",
                    "format": "binary"
                  },
                  "FaceImage": {
                    "type": "string",
                    "format": "binary"
                  }
                }
              },
              "encoding": {
                "ElectionType": {
                  "style": "form"
                },
                "ResidentialAddress": {
